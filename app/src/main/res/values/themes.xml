<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.CajamApp" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/cajamapp_paper</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
    <style name="Theme.CajamApp.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/cajamapp_forest</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/cajamapp_splash</item>
        <item name="postSplashScreenTheme">@style/Theme.CajamApp</item>
    </style>
</resources>
